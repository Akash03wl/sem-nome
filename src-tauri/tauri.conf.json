{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitra",
  "version": "0.1.0",
  "identifier": "com.vitra.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "quick",
        "title": "Vitra",
        "width": 720,
        "height": 452,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": true,
        "center": true
      },
      {
        "label": "panel",
        "title": "Vitra",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/Everything64.dll": "Everything64.dll",
      "resources/Everything-SDK-LICENSE.txt": "Everything-SDK-LICENSE.txt"
    },
    "publisher": "Vitra",
    "copyright": "© 2026 Vitra contributors · MIT",
    "category": "Utility",
    "shortDescription": "Todos os seus programas, pastas, arquivos e senhas num só lugar.",
    "longDescription": "Vitra é um lançador para Windows com visual de vidro: abre com Alt+Espaço, encontra seus programas, arquivos (Everything) e senhas (Bitwarden), e deixa a área de trabalho limpa.",
    "homepage": "https://github.com/Akash03wl/sem-nome",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    }
  }
}
